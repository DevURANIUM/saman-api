# Set these environment variables in the process supervisor or shell.
# .env is not loaded automatically.
SAMAN_HOST=127.0.0.1
SAMAN_PORT=8089
SAMAN_API_KEY=replace-with-a-long-random-secret
# Optional credentials for session ensure and automatic renewal before data calls.
# Reads may retry once after bank 401. Payments are never replayed.
# SAMAN_USER=your-mobillet-username
# SAMAN_PASS=your-mobillet-password
# SAMAN_DATA_DIR=./private-session-data
